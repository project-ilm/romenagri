<शैली गुरु>
#समावेश <मानकपन.स>

/* टिप्पणी: ऽ ऌ ॠ ॐ ॥ ॑ ॒ ॓ ॔ */
पूर्णांक मुख्य()
{
	पूर्णांक ॐ = 42;
	पूर्णांक ऌ = 7;
	म_लिखो("A:%s\n", "अ॒ग्निमी॑ळे पु॒रोहि॑तं य॒ज्ञस्य॑ दे॒वमृ॒त्विज॑म्।");
	म_लिखो("B:%s\n", "कृ कॄ कॢ कॣ ऋ ॠ ऌ ॡ");
	म_लिखो("C:%s\n", "ॐ भूर्भुवः स्वः ॥ हलोऽन्तराः ॥");
	म_लिखो("D:%s\n", "क॑ु क॒ि क़॑ा");
	म_लिखो("E:%s\n", "\u090c \u0950 \u0965 \u0951 \u0961 \u0960 \u0962 \u0963 \u0944");
	म_लिखो("F:identifiers %d %d\n", ॐ, ऌ);
	वापस 0;
}
